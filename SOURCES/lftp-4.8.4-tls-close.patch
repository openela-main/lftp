 int IOBufferSSL::PutEOF_LL()
 {
-   if(Size()==0)
-      ssl->shutdown();
+   int res;
+   if(Size()==0) {
+      res = ssl->shutdown();
+      if (res == ssl->RETRY) {
+         SetNotReady(ssl->fd,want_mask());
